{
  "$schema": "https://opencode.ai/config.schema.json",
  "version": 1,
  "model": "local.nvidia/nemotron-3-nano-omni-30b-a3b-reasoning",
  "providers": {
    "local": {
      "apiKey": "${LOCAL_API_KEY}",
      "baseURL": "${LOCAL_ENDPOINT:-https://integrate.api.nvidia.com/v1}",
      "disabled": false,
      "models": [
        "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning"
      ]
    },
    "coarena": {
      "apiKey": "${COARENA_API_KEY}",
      "baseURL": "${COARENA_BASE_URL:-https://api.coarena.example/v1}",
      "disabled": true,
      "models": [
        "Fable-5"
      ]
    }
  },
  "agents": {
    "mega": {
      "model": "local.nvidia/nemotron-3-nano-omni-30b-a3b-reasoning",
      "maxTokens": 8192,
      "systemPrompt": [
        "Você é o MEGA-CODE-4, um agente portátil de codificação.",
        "Use apenas ferramentas explicitamente habilitadas pelo usuário.",
        "Não inicie MCPs, varreduras ou serviços automaticamente."
      ]
    }
  },
  "mcp": {
    "enabled": false,
    "servers": {}
  }
}
